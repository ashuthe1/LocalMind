# LocalMind configuration — optional. Copy to .env only if you want to change a default.
# With no .env at all, LocalMind starts on http://localhost:8080 with its database in ./data
# and asks you to pick a model provider on first launch.

# Listen address. Use 0.0.0.0:8080 to reach LocalMind from your phone on the same Wi-Fi.
SERVER_ADDRESS=:8080

# Where the SQLite database and logs live.
DATA_DIR=./data

# Skip the first-run setup screen by pre-configuring a provider (only applied when none exists yet).
# DEFAULT_PROVIDER=ollama              # ollama | lmstudio | openai | anthropic | gemini
# DEFAULT_PROVIDER_URL=http://localhost:11434
# DEFAULT_PROVIDER_KEY=sk-...
# MODEL_NAME=llama3.2

# Your display name (editable in Settings → Persona).
# USER_NAME=friend

# debug | info | warn | error
LOG_LEVEL=info

# Open the UI in your browser on start.
OPEN_BROWSER=true
