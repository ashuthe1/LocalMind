# ---------------------------------------------------------------------------
# LocalMind configuration. Copy this file to .env and adjust what you need.
# Everything is optional: with no .env at all LocalMind starts on :8080 with a
# SQLite database in ./data and an Ollama provider pointing at localhost:11434.
# ---------------------------------------------------------------------------

# Address the server listens on. Use 0.0.0.0:8080 to reach it from your phone on the same Wi-Fi.
SERVER_ADDRESS=:8080

# Storage backend: sqlite (default, zero setup) or mongo.
STORAGE=sqlite
DATA_DIR=./data
# SQLITE_PATH=./data/localmind.db

# Only used when STORAGE=mongo. Existing LocalMind 1.x data is migrated automatically.
# MONGO_URI=mongodb://localhost:27017
# DATABASE_NAME=LocalMind

# First-run defaults. Used only if no provider has been configured yet; after that,
# manage providers in Settings → Providers inside the app.
DEFAULT_PROVIDER=ollama                  # ollama | lmstudio | openai | anthropic | gemini
DEFAULT_PROVIDER_URL=http://localhost:11434
# DEFAULT_PROVIDER_KEY=sk-...
MODEL_NAME=llama3.2

# Your display name (used in the prompt and the UI). Can be changed in Settings → Persona.
USER_NAME=friend

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Open the UI in your browser when the server starts.
OPEN_BROWSER=false

# Extra allowed browser origins (comma separated). localhost origins are always allowed.
# CORS_ORIGINS=http://192.168.1.20:5173

# Serve the UI from a directory instead of the files embedded in the binary (development only).
# FRONTEND_DIR=../frontend/dist
